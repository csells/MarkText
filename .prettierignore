# packages/muya (@muyajs/core) self-formats via its own ESLint config (antfu /
# @stylistic: 4-space indent + semicolons), which differs from the root Prettier
# style (2-space, no semi). Skip it so `pnpm format` doesn't fight muya's own lint.
packages/muya/

# Standards corpora preserve upstream bytes (ESLint ignores them too).
packages/document-core/test/fixtures/*.json
# Performance inputs: their exact bytes are the measured workload.
specs/baselines/representative-documents/
# Recorded run evidence keeps the bytes it was captured with.
specs/baselines/runs/
# The hand-authored interaction matrix keeps its own layout.
specs/baselines/criticmarkup-interaction-matrix.json
# pnpm owns this file's formatting; Prettier reformats it wholesale and pnpm
# rewrites it back on the next install, so the churn is pure noise.
pnpm-lock.yaml
