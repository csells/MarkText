{
    "compilerOptions": {
        "target": "ES2020",
        "paths": { "@/*": ["../../desktop/src/renderer/src/*"] },
        "lib": ["ES2021", "ES2022.Array", "ES2022.Error", "ES2022.Object", "ES2022.String", "ES2024.String", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "types": ["node", "vite/client"],
        "allowImportingTsExtensions": true,
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["../src/types/**/*.d.ts", "host/**/*", "tests/**/*", "types.d.ts", "playwright.config.ts", "vite.config.ts"]
}
