+): number {
+  let low = 0;
+  let high = values.length;
+  while (low < high) {
+    const middle = low + ((high - low) >> 1);
+    if (select(values[middle]) < target)
+      low = middle + 1;
+    else
+      high = middle;
+  }
+  return low;
